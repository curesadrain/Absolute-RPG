-- RPG GAMMA: native MAC app for Experience Framework.
assert(mac_mcm and mac_mcm.add_app, "RPG GAMMA Unified PDA requires Mod App Creator (MAC).")
mac_mcm.add_app("rpg_gamma", {
    name = "rpg_gamma_pda_title",
    texture = "ui_experience_btn_skills_wnd",
    tab = "eptRPGGamma",
    func = experience_ui.get_ui
})

function on_xml_read_callback(file_name, xml_obj)
    local name = file_name:lower():gsub("/", "\\")
    if not name:match("ui\\pda[^\\]*%.xml$") then return end
    local tabs = xml_obj:query("tab")
    if not tabs or not tabs[1] then return end
    local tab = tabs[1]
    local existing = xml_obj:query('tab > button[id="eptRPGGamma"]')
    if existing and existing[1] then return end
    xml_obj:insertFromXMLString([[
        <button x="1000" y="0" width="0" height="0" id="eptRPGGamma" frame_mode="0">
            <text align="c" vert_align="c" x="0" y="0" font="letterica16">rpg_gamma_pda_title</text>
        </button>]], tab, #tab.kids + 1)
end

function on_game_start()
    RegisterScriptCallback("on_xml_read", on_xml_read_callback)
    RegisterScriptCallback("actor_on_net_destroy", experience_ui.destroy_ui)
end
