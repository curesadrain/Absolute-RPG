local opt_str_menu                          = "ui_exp_menu_"
local opt_str_prst							= "ui_exp_prst_"
local opt_str_lst                           = "ui_exp_lst_"

local s_gsub								= string.gsub
local lerp_color							= utils_xml.lerp_color
