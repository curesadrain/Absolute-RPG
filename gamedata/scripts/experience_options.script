				{id = "base_lvl_collaider_min", hint = "NLS_level_loc_min", type = "track", val = 2, min = 1, max = 250, step = 1, def = 25, precondition = {new_levels_mod_precond}},
				{id = "base_lvl_collaider_max", hint = "NLS_level_loc_max", type = "track", val = 2, min = 1, max = 250, step = 1, def = 45, precondition = {new_levels_mod_precond}},
				{id = "divider", type = "line", precondition = {new_levels_mod_precond}},
				-- New Levels Patch END
			}
		},
		{
			id = "IronmanRoguelite", sh = true, precondition = {ironman_roguelite_precond}, output = "ui_exp_IronmanRoguelite_not_installed", gr = {
				{id = "title", type = "slide", link = "ui_experience_option_slider_anomalies", text = "ui_exp_IronmanRoguelite_title", size = {458,50}, spacing = 10},
				{id = "desc", type = "desc", text = "ui_exp_IronmanRoguelite_desc"},
				{id = "divider", type = "line"},
				{id = "TRANSFER_PROGRESS", type = "check", val = 1, def = true},
				{id = "divider", type = "line"},
				{id = "RESTORE_SKILLS", type = "check", val = 1, def = true},
				{id = "LOSS_PROGRESS", type = "track", val = 2, min = 0, max = 100, step = 1, def = 10, str_format = str_format_prec},
				{id = "RESTORE_TRAITS", type = "check", val = 1, def = true},
				{id = "divider", type = "line"},
			}
		}
	}
end

local function init_other_options()
	-- Search files with options
	local t = {}
	local flist = getFS():file_list_open_ex("$game_scripts$", bit_or(FS.FS_ListFiles, FS.FS_RootOnly), "*_exp.script")
	local f_cnt = flist:Size()
	for	it=0, f_cnt-1 do
		local file = flist:GetAt(it)
		local file_name = file:NameShort()
		if file:Size() > 0 then
			file_name = file_name:sub(0, file_name:len()-7)
			if (_G[file_name] and _G[file_name].on_exp_load) then
				table.insert(t, file_name)
			end
		end
	end

	-- Initialize options from finded files
	local temp = {}
	for i=1, #t do
		local op, op_id = _G[ t[i] ].on_exp_load(temp)
		if type(op) == "table" then
			if (op_id and type(op_id) == "string" and op.id and op.gr) then
				local index = nil
				for k=1, #temp do
					if temp[k].id == op_id then
						index = k
						break
					end
				end
				if index ~= nil then
					if not temp[index].sh then
						table.insert(temp[index].gr, op)
					else
						experience_dbg.Write(1, "experience_options.init_other_options | Error: Attempt to add options to an incompatible section '%s' | Argument: 'sh' is exist.", temp[index].id)
					end
				else
					local s = {id = op_id, gr = {}}
					table.insert(s.gr, op)
					table.insert(temp, s)
				end

			elseif (op.id and op.gr) then
				table.insert(temp, op)
			else
				experience_dbg.Write(1, "experience_options.init_other_options | Error: Can't import options from '%s.script' | Bad arguments.", t[i])
			end
		elseif op ~= nil then
			experience_dbg.Write(1, "experience_options.init_other_options | Error: Can't import options from '%s.script' | Bad argument #1 (table expected, got '%s').", t[i], type(op))
		end
	end

	-- Import valid options
	for _,op in spairs(temp, sort_option_func) do
		table.insert(options, op)
	end
end

function Get(id, def)
	if opt_unknown[id] then
		return def
	end

	if #options == 0 then
		LoadOptions()
	end

    local value = ini_options:r_value(opt_section, id, opt_val[id])
	if value ~= nil then
		return value
	end

    local v = get_opt_table(id)
	value = v.def
    if value ~= nil then
		Set(id, value)
		return value
    end

	experience_dbg.Write(1, "Found nil option value [%s]", id)
	opt_unknown[id] = true
	return def
end

function Set(id, value)
	if (opt_unknown[id] and value ~= nil) then
		opt_unknown[id] = nil
	end
    ini_options:w_value(opt_section, id, value)
    ini_options:save()
end

