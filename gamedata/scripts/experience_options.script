GUI = nil
function get_ui(owner, xml)
    if GUI == nil then
        GUI = UIExperienceOptions(owner, xml)
    end
    return GUI
end
----------------------------------------------------
-- Class "UIExperienceOptions"
----------------------------------------------------
class "UIExperienceOptions" (CUIWindow)
function UIExperienceOptions:__init(owner, xml) super()
    self.owner = owner
    self.xml = xml

    self.tree = {}
    self.tr_btn = {}
    self.Cache = {
        _Cap = {},
		_Hint = {},
        _Check = {},
        _List = {},
        _Input = {},
        _Track = {},
        _Radio = {},
		_ImageList = {},
		last_curr_tree = {},
        last_path = nil
    }
    self.presets = {}
    self.Save_INI = false
	self.Change_Done = false

	if #options == 0 then
		LoadOptions()
	end

    self:InitControls()
    self:InitCallBacks()
    self:InitPresets()
	self:Register_Tree(1, "", options)
end

function UIExperienceOptions:InitControls()
    local xml = self.xml

    self.dialog                                 = xml:InitStatic("options_wnd:main:frame", self)

    self.btn_accept                             = xml:Init3tButton("options_wnd:main:btn_accept", self.dialog)
    self:Register(self.btn_accept, "btn_accept")

    self.btn_default                            = xml:Init3tButton("options_wnd:main:btn_default", self.dialog)
    self:Register(self.btn_default, "btn_default")

    self.btn_cancel                             = xml:Init3tButton("options_wnd:main:btn_cancel", self.dialog)
    self:Register(self.btn_cancel, "btn_cancel")

    self.scroll_opt                             = xml:InitScrollView("options_wnd:main:scroll", self.dialog)

	self.presets_cap                          = xml:InitStatic("options_wnd:main:cap_presets", self.dialog)
	self.lst_presets                          = experience_ui.UIComboBoxCustom(xml, "options_wnd:main:presets", self.dialog)
    self.presets_cap:Show(false)
	self.lst_presets:Show(false)

    self.pending_text                           = xml:InitTextWnd("options_wnd:main:notify", self.dialog)
end

function UIExperienceOptions:InitCallBacks()
	self:AddCallback("btn_accept",      ui_events.BUTTON_CLICKED,			self.OnButton_Accept,       self)
	self:AddCallback("btn_default",     ui_events.BUTTON_CLICKED,			self.OnButton_Default,      self)
	self:AddCallback("btn_cancel",      ui_events.BUTTON_CLICKED,			self.OnButton_Cancel,       self)
	self.lst_presets:SetCallback(self.Callback_Preset, self)
end

function UIExperienceOptions:InitPresets()
	local t = {}
	ini_presets:section_for_each(function(section)
		local result,path,value
		local n = ini_presets:line_count(section)
		for i=0, n-1 do
			result, path, value = ini_presets:r_line_ex(section, i, "","")
			if path and value and opt_val[path] then
				local val
				if opt_val[path] == 1 then
					val = value == "true"
				elseif opt_val[path] == 2 then
					val = tonumber(value)
				else
					val = value
				end
				if val ~= nil then
					if not t[section] then
						t[section] = {}
					end
					t[section][path] = val
				else
					experience_dbg.Write(1, "UIExperienceOptions:InitPresets | Error: Incorrect value in preset. \\nPreset: %s \\nOption: %s \\nValue: %s", section, path, value)
				end
			end
		end
	end)

	if is_not_empty(t) then
		self.presets_cap:Show(true)
		self.lst_presets:Show(true)
		local num = 0
		for sec, v in spairs(t, sort_preset_func) do
			num = num + 1
			self.presets[num] = v
			self.lst_presets:AddItem(game.translate_string(opt_str_prst .. sec), num)
		end
	end
end

-- Called from experience_ui.UIExperienceMenu.Update
function UIExperienceOptions:Update()
	for id, e in pairs(self.Cache._Track) do
		if e.ctrl:IsCursorOverWindow() then
			local v = self:GetOption(id)
			local value = round_idp(e.ctrl:GetFValue(), v.prec or precision)
			if value ~= e.value then
				e.value = value
				self:Callback_Track(e.txt, e.path, e.opt, e.clr, v, value)
				return
			end
		end
	end
end

-- Called from experience_ui.UIExperienceMenu.ProcessHint
function UIExperienceOptions:ProcessHint(hint_wnd)
    for id, ctrl in pairs(self.Cache._Cap) do
		if ctrl:IsCursorOverWindow() then
			local str = opt_str .. (self.Cache._Hint[id] or id) .. "_desc"
			local str_t = game.translate_string(str)
			if str ~= str_t then
				hint_wnd:Update(str_t)
				return true
			end
			return false
		end
	end
end

-- Called from experience_ui.UIExperienceMenu.OnKeyboard
function UIExperienceOptions:OnKeyboard(res, dik, keyboard_action)
    if res == false then
        if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
            if dik == DIK_keys.DIK_ESCAPE then
				self:CloseWindow()
            end
        end
    end
end

function UIExperienceOptions:CloseWindow(dont_play_sound)
	self.owner:CloseCurrentWindow(dont_play_sound)
end

-- Called from experience_ui.UIExperienceMenu.CloseCurrentWindow
function UIExperienceOptions:Close()
	if is_not_empty(opt_temp) then
		empty_table(opt_temp)
		empty_table(opt_backup)
	end
	self:Show(false)
end

function UIExperienceOptions:Register(obj, id)
    self.owner:Register(obj, "options_wnd_" .. id)
end

function UIExperienceOptions:AddCallback(id, action, functor, obj)
    self.owner:AddCallback("options_wnd_" .. id, action, functor, obj)
end

function UIExperienceOptions:PlaySND(key)
    self.owner:PlaySND(key)
end

function UIExperienceOptions:SetMsg(text, tmr, align)
    self.owner:SetMsg(text, tmr, align)
end

function UIExperienceOptions:UpdateActorStats()
    self.owner:UpdateActorStats()
end

function UIExperienceOptions:Reset()
	if self.Cache.last_curr_tree and self.Cache.last_path then
		self:Reset_opt(self.Cache.last_curr_tree, self.Cache.last_path)
		self:UpdatePending()
	end
end

function UIExperienceOptions:ClearCache()
	self.scroll_opt:Clear()
    empty_table(self.Cache._Cap)
	empty_table(self.Cache._Hint)
    empty_table(self.Cache._Check)
    empty_table(self.Cache._List)
    empty_table(self.Cache._Input)
    empty_table(self.Cache._Track)
    empty_table(self.Cache._Radio)
	empty_table(self.Cache._ImageList)
end

function UIExperienceOptions:Reset_opt(curr_tree, path, flags)
	flags = flags or {}
	local xml = self.xml
	self:ClearCache()

	if curr_tree.precondition and (not exec(unpack(curr_tree.precondition))) then
		if curr_tree.output then
			local _txt = xml:InitTextWnd("options_wnd:elements:block", nil)
			_txt:SetText(game.translate_string(curr_tree.output))
			self.scroll_opt:AddWindow(_txt, true)
			_txt:SetAutoDelete(false)
		end
		return
	end

    for i=1, #curr_tree.gr do
		-- The PDA owns the background. Keep the legacy option in configuration
        -- for cache/preset compatibility, but never construct its image preview.
        local pda_background = path == "UI" and curr_tree.gr[i].id == "MENU_BACKGROUND"
        local to_hide = pda_background or (curr_tree.gr[i].precondition and (not exec(unpack(curr_tree.gr[i].precondition))))

		if not to_hide then
			local opt = curr_tree.gr[i].id
			local v = curr_tree.gr[i]
			local _st = xml:InitStatic("options_wnd:main:st", nil)
			local _h = 0
	
--------------- Support
			if v.type == "line" then
				_h = self:Register_Line(xml, _st)
	
			elseif v.type == "image" then
				_h = self:Register_Image(xml, _st, v)
	
			elseif v.type == "slide" then
				_h = self:Register_Slide(xml, _st, v)
	
			elseif v.type == "title" then
				_h = self:Register_Title(xml, _st, v)
	
			elseif v.type == "desc" then
				_h = self:Register_Desc(xml, _st, v)
	
--------------- Option
			elseif v.type == "check" then
				_h = self:Register_Check(xml, _st, path, opt, v, flags)
	
			elseif v.type == "button" then
				_h = self:Register_Button(xml, _st, path, opt, v)
	
			elseif v.type == "list" then
				_h = self:Register_List(xml, _st, path, opt, v, flags)
	
			elseif v.type == "input" then
				_h = self:Register_Input(xml, _st, path, opt, v, flags)
	
			elseif v.type == "track" then
				_h = self:Register_Track(xml, _st, path, opt, v, flags)
	
			elseif (v.type == "radio_h") then
				_h = self:Register_Radio(xml, _st, path, opt, v, true, flags)
	
			elseif (v.type == "radio_v") then
				_h = self:Register_Radio(xml, _st, path, opt, v, false, flags)

			elseif (v.type == "image_list") then
				_h = self:Register_ImageList(xml, _st, path, opt, v, flags)
			end
	
			_st:SetWndSize(vector2():set(_st:GetWidth(), _h + 10))
			self.scroll_opt:AddWindow(_st, true)
			_st:SetAutoDelete(true)
		end
    end
    if self.Save_INI then
        self.Save_INI = false
        ini_options:save()
    end
end

function UIExperienceOptions:Register_Tree(tree_num, path, curr_tree)
    local xml = self.xml

    if not self.tree[tree_num] then
        self.tree[tree_num] = {}
    end

    if not self.tree[tree_num][path] then
		self.tree[tree_num][path] = xml:InitScrollView("options_wnd:main:tree_" .. tree_num, self.dialog)

		if not self.tr_btn[tree_num] then
			self.tr_btn[tree_num] = {}
		end
	
		self.tr_btn[tree_num][path] = {}
		for i=1, #curr_tree do
			local _st = xml:InitStatic("options_wnd:main:st_tree", nil)
	
			self.tr_btn[tree_num][path][i] = xml:InitCheck("options_wnd:main:btn_tree", _st)
			self.tr_btn[tree_num][path][i]:SetCheck(false)
	
			local text = xml:InitTextWnd("options_wnd:main:txt_btn_tree", _st)
			text:SetText(game.translate_string(opt_str_menu .. curr_tree[i].id))
			self.tree[tree_num][path]:AddWindow(_st, true)
			_st:SetAutoDelete(false)
		end
	
		for i=1, #self.tr_btn[tree_num][path] do
			local path_i = (path ~= "") and cc(path, curr_tree[i].id) or curr_tree[i].id
	
			self:Register(self.tr_btn[tree_num][path][i], "tree_" .. path_i)
			local _wrapper = function(handler)
				self:Callback_Tree(tree_num, path_i, curr_tree[i], self.tr_btn[tree_num][path], i, true)
			end
			self:AddCallback(("tree_"..path_i), ui_events.BUTTON_CLICKED, _wrapper, self)
		end
	end

	self.tree[tree_num][path]:Show(true)
	self.tr_btn[tree_num][path][1]:SetCheck(true)
	local path_1 = (path ~= "") and cc(path, curr_tree[1].id) or curr_tree[1].id
	self:Callback_Tree(tree_num, path_1, curr_tree[1], self.tr_btn[tree_num][path], 1)
end

function UIExperienceOptions:Callback_Tree(tree_num, path, curr_tree, ctrl, i, play_sound)
	if (ctrl[i]:GetCheck() == false) then
		ctrl[i]:SetCheck(true)
		return
	end
	for k=1, #ctrl do
		if k ~= i then
			ctrl[k]:SetCheck(false)
		end
	end

    for k=tree_num+1, #self.tree do
		for _,v in pairs(self.tree[k]) do
			v:Show(false)
		end
	end

    if #curr_tree.gr == 0 then
		self:ClearCache()
	elseif curr_tree.sh then
		self:Reset_opt(curr_tree, path)

		self.Cache.last_path = path
		empty_table(self.Cache.last_curr_tree)
		copy_table(self.Cache.last_curr_tree, curr_tree)
	else
		self:Register_Tree(tree_num+1, path, curr_tree.gr, i)
	end

	if play_sound then
		self:PlaySND("menu_click_4")
	end
end

------------------------------------------------------------
-- Elements
------------------------------------------------------------
function UIExperienceOptions:Register_Cap(xml, handler, id, hint)
	local id = s_gsub(id, _opt_, "_")
	if hint then
		self.Cache._Hint[id] = hint
	end
	self.Cache._Cap[id] = xml:InitStatic("options_wnd:elements:cap", handler)
	self.Cache._Cap[id]:TextControl():SetText(game.translate_string(opt_str .. (hint or id)))
	return self.Cache._Cap[id]:GetHeight()
end

function UIExperienceOptions:Register_Line(xml, handler)
	local line = xml:InitStatic("options_wnd:elements:divider", handler)
	return line:GetHeight() + 10
end

function UIExperienceOptions:Register_Image(xml, handler, v)
    if not v.link then
        return 0
    end

    local pic = xml:InitStatic("options_wnd:elements:image", handler)
    pic:InitTexture(v.link)
    if v.pos then
        local pos = pic:GetWndPos()
        pic:SetWndPos(vector2():set(pos.x + v.pos[1] , pos.y + v.pos[2]))
    end
	if v.size then
    	pic:SetWndSize(vector2():set(v.size[1] , v.size[2]))
	end
    return pic:GetWndPos().y + pic:GetHeight() + 10
end

function UIExperienceOptions:Register_Slide(xml, handler, v)
	local frame = xml:InitStatic("options_wnd:elements:slide", handler)
	local _pos = frame:GetWndPos()
	frame:SetWndPos(vector2():set(_pos.x , _pos.y + (v.spacing or 10)))
	
	local pic = xml:InitStatic("options_wnd:elements:slide:pic", frame)
	if v.link then
		pic:InitTexture(v.link)
		if (v.pos) then
			local pos = pic:GetWndPos()
			pic:SetWndPos(vector2():set(pos.x + v.pos[1] , pos.y + v.pos[2]))
		end
		if (v.size) then
			pic:SetWndSize(vector2():set(v.size[1] * width_factor , v.size[2]))
		end
	end

    xml:InitStatic("options_wnd:elements:slide:line_1", frame)
	local line2 = xml:InitStatic("options_wnd:elements:slide:line_2", frame)
    line2:SetWndPos(vector2():set(line2:GetWndPos().x, pic:GetWndPos().y + pic:GetHeight()))
    frame:SetWndSize(vector2():set(frame:GetWidth(), line2:GetWndPos().y + line2:GetHeight()))

    local txt = xml:InitTextWnd("options_wnd:elements:slide:txt", frame)
	if v.text then
		txt:SetText(game.translate_string(v.text))
        txt:SetWndSize(vector2():set(txt:GetWidth(), frame:GetHeight()))
	end
	return frame:GetWndPos().y + frame:GetHeight() + 10
end

function UIExperienceOptions:Register_Title(xml, handler, v)
	local title = xml:InitTextWnd("options_wnd:elements:title_" .. (v.align or "l"), handler)
	title:SetText(game.translate_string(v.text))
	title:AdjustHeightToText()
	title:SetWndSize(vector2():set(title:GetWidth(), title:GetHeight() + 20))
	if v.clr and v.clr[4] then
		title:SetTextColor(GetARGB(v.clr[1], v.clr[2], v.clr[3], v.clr[4]))
	end
	return title:GetHeight()
end

function UIExperienceOptions:Register_Desc(xml, handler, v)
	local desc = xml:InitTextWnd("options_wnd:elements:desc", handler)
	desc:SetText(game.translate_string(v.text))
	desc:AdjustHeightToText()
	desc:SetWndSize(vector2():set(desc:GetWidth(), desc:GetHeight() + 20))
	if v.clr and v.clr[4] then
		desc:SetTextColor(GetARGB(v.clr[1], v.clr[2], v.clr[3], v.clr[4]))
	end
	return desc:GetHeight()
end

function UIExperienceOptions:Register_Check(xml, handler, path, opt, v, flags)
	local id = cc(path, opt)
	local h = self:Register_Cap(xml, handler,  id, v.hint)

	self.Cache._Check[id] = {}
	self.Cache._Check[id].ctrl = xml:InitCheck("options_wnd:elements:check", handler)
	local ctrl = self.Cache._Check[id].ctrl

	if (ctrl:GetHeight() > h) then
		h = ctrl:GetHeight()
	end

	local value = self:GetValue(path, opt, v, flags)
	ctrl:SetCheck(value)

	local id_ctrl = self:Stacker(path, opt, v)
	self:Register(self.Cache._Check[id].ctrl, id_ctrl)
	local _wrapper = function(handler)
		self:Callback_Check(self.Cache._Check[id].ctrl, path, opt, v)
	end
	self:AddCallback(id_ctrl, ui_events.BUTTON_CLICKED, _wrapper, self)
	return h + 10
end

function UIExperienceOptions:Callback_Check(ctrl, path, opt, v)
	local value = ctrl:GetCheck()
	self:CacheValue(path, opt, value, v)
end

function UIExperienceOptions:Register_Button(xml, handler, path, opt, v)
	local id = cc(path, opt)

	xml:InitFrame("options_wnd:elements:frame_button", handler)

	local ctrl = xml:Init3tButton("options_wnd:elements:btn_button", handler)
	local h = ctrl:GetHeight()

	local id_cap = s_gsub(id, _opt_, "_")
	self.Cache._Cap[id_cap] = xml:InitStatic("options_wnd:elements:cap_button", handler)
	self.Cache._Cap[id_cap]:TextControl():SetText(game.translate_string(opt_str .. (v.hint or id_cap)))
	if (self.Cache._Cap[id_cap]:GetHeight() > h) then
		h = self.Cache._Cap[id_cap]:GetHeight()
	end

	local id_ctrl = self:Stacker(path, opt, v)

	self:Register(ctrl, id_ctrl)
	local _wrapper = function(handler)
		self:Callback_Button(ctrl, path, opt, v)
	end
	self:AddCallback(id_ctrl, ui_events.BUTTON_CLICKED, _wrapper, self)
	
	return h + 10
end

function UIExperienceOptions:Callback_Button(ctrl, path, opt, v)
	if v.functor_ui then
		exec(unpack(v.functor_ui), self)
	end
	if v.functor then
		exec(unpack(v.functor))
	end
end

function UIExperienceOptions:Register_List(xml, handler, path, opt, v, flags)
    local idx
	local id = cc(path, opt)
	self:Register_Cap(xml, handler,  id, v.hint)

	local value = self:GetValue(path, opt, v, flags)
	local content = self:GetContent(path, opt, v)

	self.Cache._List[id] = {}
	self.Cache._List[id].ctrl = experience_ui.UIComboBoxCustom(xml, "options_wnd:elements:list", handler)
	local ctrl = self.Cache._List[id].ctrl

	for i=1, #content do
		local str_2 = content[i][2] or tostring(content[i][1])
		local str = v.no_str and str_2 or opt_str_lst .. str_2
		ctrl:AddItem(game.translate_string(str), i)
		
		if content[i][1] == value then
			idx = i
		end
	end

	idx = idx or 1
	ctrl:SetCurrentID(idx)

	local _wrapper = function(handler)
		self:Callback_List(self.Cache._List[id].ctrl, path, opt, v)
	end
	ctrl:SetCallback(_wrapper, self)
	
	return ctrl:GetWndPos().y + ctrl:GetHeight()
end

function UIExperienceOptions:Callback_List(ctrl, path, opt, v)
	local i = ctrl:GetCurrentID()
	local content = self:GetContent(path, opt, v)
	self:CacheValue(path, opt, content[i][1], v)
	if v.on_select then
		exec(v.on_select, content[i][1])
	end
end

function UIExperienceOptions:Register_Input(xml, handler, path, opt, v, flags)
	local id = cc(path, opt)

	local h = self:Register_Cap(xml, handler,  id, v.hint)

	self.Cache._Input[id] = {}
	self.Cache._Input[id].ctrl = xml:InitEditBox("options_wnd:elements:input", handler)
	local ctrl = self.Cache._Input[id].ctrl

	if (ctrl:GetHeight() > h) then
		h = ctrl:GetHeight()
	end

	local value = self:GetValue(path, opt, v, flags)
	ctrl:SetText(value)

	local id_ctrl = self:Stacker(path, opt, v)

	self:Register(self.Cache._Input[id].ctrl, id_ctrl)
	local _wrapper = function(handler)
		self:Callback_Input(self.Cache._Input[id].ctrl, path, opt, v)
	end
	self:AddCallback(id_ctrl, ui_events.EDIT_TEXT_COMMIT, _wrapper, self)

	return h + 10
end

function UIExperienceOptions:Callback_Input(ctrl, path, opt, v)
	local value = ctrl:GetText()
	if not (value and value ~= "") then
		ctrl:SetText(self:GetCurrentValue(path, opt, v) or self:GetDefaultValue(path, opt, v))
		return
	end
	
	if v.val == 2 then
		value = tonumber(value)
		if not value then
			ctrl:SetText(self:GetCurrentValue(path, opt, v) or self:GetDefaultValue(path, opt, v))
			return
		end
		if v.round then
			value = round(value)
		end
		value = clamp(value, v.min, v.max)
	end

	self:CacheValue(path, opt, value, v)
	ctrl:SetText(value)
end

function UIExperienceOptions:Register_Track(xml, handler, path, opt, v, flags)
	local id = cc(path, opt)

	local h = self:Register_Cap(xml, handler,  id, v.hint)

	self.Cache._Track[id] = {}
	self.Cache._Track[id].ctrl = xml:InitTrackBar("options_wnd:elements:track", handler)
	self.Cache._Track[id].path = path
	self.Cache._Track[id].opt = opt
	if self.Cache._Track[id].ctrl:GetHeight() > h then
		h = self.Cache._Track[id].ctrl:GetHeight()
	end

	self.Cache._Track[id].txt = xml:InitTextWnd("options_wnd:elements:track_value", handler)

	local value = self:GetValue(path, opt, v, flags)
	value = clamp(value, v.min, v.max)
	value = round_idp(value, v.prec or precision)

	self.Cache._Track[id].value = value
	self.Cache._Track[id].ctrl:SetInvert(v.invert and true or false)
	self.Cache._Track[id].ctrl:SetStep(v.step)
	self.Cache._Track[id].ctrl:SetOptFBounds(v.min, v.max)
	self.Cache._Track[id].ctrl:SetFValue(value)

	if not v.no_str then
		if v.str_format then
			self.Cache._Track[id].txt:SetText(strformat(game.translate_string(v.str_format), value))
		else
			self.Cache._Track[id].txt:SetText(value)
		end
		if v.lerp_clr and #v.lerp_clr == 3 then
			local min = v.lerp_clr[1]
			local mid = v.lerp_clr[2]
			local max = v.lerp_clr[3]
			self.Cache._Track[id].clr = {}
			self.Cache._Track[id].clr.min = { min[1], min[2], min[3], min[4], v.min }
			self.Cache._Track[id].clr.mid = { mid[1], mid[2], mid[3], mid[4], (v.min + v.max) / 2 }
			self.Cache._Track[id].clr.max = { max[1], max[2], max[3], max[4], v.max }
			self.Cache._Track[id].txt:SetTextColor(lerp_color(value, self.Cache._Track[id].clr.min, self.Cache._Track[id].clr.mid, self.Cache._Track[id].clr.max))
		end
	end

	return h + 10
end

function UIExperienceOptions:Callback_Track(ctrl, path, opt, clr, v, value)
	if not v.no_str then
		if v.str_format then
			ctrl:SetText(strformat(game.translate_string(v.str_format), value))
		else
			ctrl:SetText(value)
		end
		if clr then
			ctrl:SetTextColor(lerp_color(value, clr.min, clr.mid, clr.max))
		end
	end
	self:CacheValue(path, opt, value, v)
end

function UIExperienceOptions:Register_Radio(xml, handler, path, opt, v, typ, flags)
	local id = cc(path, opt)

	local h = self:Register_Cap(xml, handler,  id, v.hint)
	
	local str = typ and "horz" or "vert"
	local content = self:GetContent(path, opt, v)
	local num = #content
	if (num > 5 and not v.force_horz) then
		typ = false
		str = "vert"
	end
	
	self.Cache._Radio[id] = {}
	self.Cache._Radio[id].ctrl = {}
	local ctrl = self.Cache._Radio[id].ctrl

	local frame = xml:InitStatic("options_wnd:elements:radio_" .. str, handler)
	local txt
	local offset = typ and math.floor(frame:GetWidth()/num) or 30
	local h_factor = typ and 1 or 0
	local v_factor = typ and 0 or 1
	local h1, h2 = 0, 0
	for i=1, num do 
		ctrl[i] = xml:InitCheck("options_wnd:elements:radio_" .. str .. ":btn", frame)
		local pos = ctrl[i]:GetWndPos()
		h1 = (h1 * v_factor) + ctrl[i]:GetHeight()
		ctrl[i]:SetWndPos(vector2():set( pos.x + ((i-1) * offset * h_factor) , pos.y + ((i-1) * offset * v_factor) ))
		
		txt = xml:InitTextWnd("options_wnd:elements:radio_" .. str .. ":txt", frame)
		local pos2 = txt:GetWndPos()
		h2 = h_factor * txt:GetHeight()
		txt:SetWndPos(vector2():set( pos2.x + ((i-1) * offset * h_factor) , pos2.y - (v_factor * 30) + ((i-1) * offset * v_factor) ))
		local str_2 = content[i][2] or tostring(content[i][1])
		local str = v.no_str and str_2 or opt_str_lst .. str_2
		txt:SetText(game.translate_string(str))
		
		if (h1 + h2 > h) then
			h = h1 + h2
		end
	end
	
	local value = self:GetValue(path, opt, v, flags)
	
	local id_ctrl = self:Stacker(path, opt, v)
	for i=1, num do
		if (content[i][1] == value) then
			ctrl[i]:SetCheck(true)
		else
			ctrl[i]:SetCheck(false)
		end
		
		self:Register(self.Cache._Radio[id].ctrl[i], id_ctrl .. i)
		local _wrapper = function(handler)
			self:Callback_Radio(self.Cache._Radio[id].ctrl, path, opt, v, i)
		end
		self:AddCallback(id_ctrl .. i, ui_events.BUTTON_CLICKED, _wrapper, self)
	end
	
	return h + 10
end

function UIExperienceOptions:Callback_Radio(ctrl, path, opt, v, n)
	local value = ctrl[n]:GetCheck()
	if value then
		for i=1,#ctrl do
			if i ~= n then
				ctrl[i]:SetCheck(false)
			end
		end
		
		local content = self:GetContent(path, opt, v)
		self:CacheValue(path, opt, content[n][1], v)
		if v.on_select then
			exec(v.on_select, content[n][1])
		end
	else
		ctrl[n]:SetCheck(true)
	end
end

function UIExperienceOptions:Register_ImageList(xml, handler, path, opt, v, flags)
	local id = cc(path, opt)
	local h = 0
	local w_h = handler:GetWidth() / 2


	-- Cap
	local c_id = s_gsub(id, _opt_, "_")
	if v.hint then
		self.Cache._Hint[c_id] = v.hint
	end
	self.Cache._Cap[c_id] = xml:InitStatic("options_wnd:elements:title_c", handler)
	self.Cache._Cap[c_id]:TextControl():SetText(game.translate_string(opt_str .. (v.hint or c_id)))
	self.Cache._Cap[c_id]:TextControl():SetTextColor(clr_g1)
	self.Cache._Cap[c_id]:SetWndSize(vector2():set( self.Cache._Cap[c_id]:GetWidth(), self.Cache._Cap[c_id]:GetHeight() + 10 ))

	h = h + self.Cache._Cap[c_id]:GetWndPos().y + self.Cache._Cap[c_id]:GetHeight()
	local value = self:GetValue(path, opt, v, flags)


	-- Image
	self.Cache._ImageList[id] = {}
	self.Cache._ImageList[id].pic = xml:InitStatic("options_wnd:elements:image", handler)

	local pic = self.Cache._ImageList[id].pic
    pic:InitTexture(v.link and v.link .. value or value)

	if v.size then
    	pic:SetWndSize(vector2():set( v.size[1] , v.size[2] ))
	end
	pic:SetWndPos(vector2():set( w_h - pic:GetWidth() / 2 , h ))

	h = h + pic:GetHeight() + 10


	-- List
	self.Cache._ImageList[id].list = experience_ui.UIComboBoxCustom(xml, "options_wnd:elements:list", handler)
	local list = self.Cache._ImageList[id].list
	list:SetWndPos(vector2():set( w_h - list:GetWidth() / 2 , h ))

	local idx = 1
	local content = self:GetContent(path, opt, v)
	for i=1, #content do
		local str_2 = content[i][2] or tostring(content[i][1])
		local str = v.no_str and str_2 or opt_str_lst .. str_2
		list:AddItem(game.translate_string(str), i)

		if content[i][1] == value then
			idx = i
		end
	end

	list:SetCurrentID(idx)
	local _wrapper = function(handler)
		self:Callback_ImageList(self.Cache._ImageList[id].pic, self.Cache._ImageList[id].list, path, opt, v)
	end
	list:SetCallback(_wrapper, self)


	h = h + list:GetHeight()
    return h
end

function UIExperienceOptions:Callback_ImageList(pic, list, path, opt, v)
	local i = list:GetCurrentID()
	local content = self:GetContent(path, opt, v)
	local value = content[i][1]

	pic:InitTexture(v.link and v.link .. value or value)
	self:CacheValue(path, opt, value, v)
	if v.on_select then
		exec(v.on_select, value)
	end
end


----------------------------------------------------
-- Utilities
----------------------------------------------------
function UIExperienceOptions:GetValue(path, opt, v, flags)
    local value

	if (flags and flags.def) then
		value = self:GetDefaultValue(path, opt, v)
	end

    if value ~= nil or (flags and flags.def) then
        if (value ~= nil and v.type == "track") then
            value = clamp(value, v.min, v.max)
        end
        self:CacheValue(path, opt, value, v)
    end

    if value == nil then
        value = self:GetCurrentValue(path, opt, v)
    end
    if value == nil then
        value = self:GetDefaultValue(path, opt, v)
    end

    if (value ~= nil and v.type == "track") then
        value = clamp(value, v.min, v.max)
    end

    return value
end

function UIExperienceOptions:GetDefaultValue(path, opt, v)
	local id = cc(path, opt)
	local value
	
	if type(v.def) == "table" then
		value = exec(unpack(v.def))
	else
		value = v.def
	end

	if (ini_options:r_value(opt_section, id, v.val) == nil and value ~= nil) then
		if opt_unknown[id] then
			opt_unknown[id] = nil
		end
        ini_options:w_value(opt_section, id, value)
		self.Save_INI = true
	end
	
	return value
end

function UIExperienceOptions:GetCurrentValue(path, opt, v)
	local id = cc(path, opt)

	if opt_temp[id] ~= nil then
		local _id = s_gsub(id, _opt_, "_")
		if (self.Cache._Cap[_id] and self.Cache._Cap[_id]:IsShown()) then
			self.Cache._Cap[_id]:TextControl():SetTextColor(clr_o)
		end
		return opt_temp[id]
	end
	
	local value
	if v.curr then
		value = exec(unpack(v.curr))
	else
		value = ini_options:r_value(opt_section, id, v.val)
	end

	return value
end

function UIExperienceOptions:GetContent(path, opt, v)
    if type(v.content[1]) == "function" then
		return exec(unpack(v.content))
	else
		return v.content
	end
end

function UIExperienceOptions:GetOption(id)
	local t = str_explode(id, _opt_ )
	local v = options
	for i=1, #t do
		for j=1, #v do
			if v[j].id == t[i] then
				if i == #t then
					v = v[j]
				else
					v = v[j].gr
				end
				break
			end
		end
	end
	return v
end

function UIExperienceOptions:CacheValue(path, opt, value, v)
	local id = cc(path, opt)

	if (opt_backup[id] == nil) then
		opt_backup[id] = self:GetValue(path, opt, v)
	end

	if (value ~= nil) and (value ~= opt_backup[id]) then
		opt_temp[id] = value
	else
		opt_temp[id] = nil
	end

	local _id = s_gsub(id, _opt_, "_")
	if (self.Cache._Cap[_id] and self.Cache._Cap[_id]:IsShown()) then
		if (opt_temp[id] ~= nil and opt_temp[id] ~= opt_backup[id]) then
			self.Cache._Cap[_id]:TextControl():SetTextColor(clr_o)
		else
			self.Cache._Cap[_id]:TextControl():SetTextColor(clr_g1)
		end
	end

	self:UpdatePending()
end

function UIExperienceOptions:Stacker(path, opt, v)
    if not v.stack then
        v.stack = 0
    end
    v.stack = v.stack + 1
    return cc(cc(path, opt), v.stack)
end

function UIExperienceOptions:UpdatePending()
	local size = size_table(opt_temp)
	if size > 0 then
		self.pending_text:SetText(strformat(game.translate_string("ui_experience_options_warning_pending"), size))
	else
		self.pending_text:SetText("")
	end
end


----------------------------------------------------
-- Callbacks
----------------------------------------------------
function UIExperienceOptions:Callback_Preset()
	self:PlaySND("menu_click_2")
	local idx = self.lst_presets:GetCurrentID()
	self.lst_presets:SetCurrentID(0)

	for id, value in pairs(self.presets[idx]) do
		local v = get_opt_table(id)
		local to_hide = v and v.precondition and (not exec(unpack(v.precondition)))
		if (v and v.type and not to_hide) then
			local t = path_opt_explode(id)
			local opt = t[#t]
			local path = t[1]
			for i=2, #t-1 do
				path = cc(path, t[i])
			end

			if self.Cache._Check[id] then
				local ctrl = self.Cache._Check[id].ctrl
				if ctrl:GetCheck() ~= value then
					ctrl:SetCheck(value)
					self:Callback_Check(ctrl, path, opt, v)
				end

			elseif self.Cache._List[id] then
				local ctrl = self.Cache._List[id].ctrl
				local content = self:GetContent(path, opt, v)
				for i=1, #content do
					if content[i][1] == value then
						if self:GetValue(path, opt, v) ~= value then
							ctrl:SetCurrentID(i)
							self:Callback_List(ctrl, path, opt, v)
						end
						break
					end
				end

			elseif self.Cache._Input[id] then
				local ctrl = self.Cache._Input[id].ctrl
				if ctrl:GetText() ~= tostring(value) then
					ctrl:SetText(value)
					self:Callback_Input(ctrl, path, opt, v)
				end

			elseif self.Cache._Track[id] then
				local e = self.Cache._Track[id]
				local val = clamp(value, v.min, v.max)
				val = round_idp(val, v.prec or precision)
				if val ~= e.value then
					e.ctrl:SetFValue(val)
					e.value = val
					self:Callback_Track(e.txt, path, opt, e.clr, v, val)
				end

			elseif self.Cache._Radio[id] then
				local ctrl = self.Cache._Radio[id].ctrl
				local content = self:GetContent(path, opt, v)
				for i=1, #content do
					if content[i][1] == value then
						if ctrl[i]:GetCheck() == false then
							ctrl[i]:SetCheck(true)
							self:Callback_Radio(ctrl, path, opt, v, i)
						end
						break
					end
				end

			elseif self.Cache._ImageList[id] then
				local content = self:GetContent(path, opt, v)
				for i=1, #content do
					if content[i][1] == value then
						if self:GetValue(path, opt, v) ~= value then
							self.Cache._ImageList[id].list:SetCurrentID(i)
							self:Callback_ImageList(self.Cache._ImageList[id].pic, self.Cache._ImageList[id].list, path, opt, v)
						end
						break
					end
				end
			else
				self:CacheValue(path, opt, value, v)
			end
		end
	end
end

function UIExperienceOptions:OnButton_Accept()
	for id, val in pairs(opt_temp) do
		local v = self:GetOption(id)

		if not v.curr then
			if (opt_unknown[id] and val ~= nil) then
				opt_unknown[id] = nil
			end
			ini_options:w_value(opt_section, id, val)
			self.Save_INI = true
		end
		self.Change_Done = true

		if v.functor then
			if v.postcondition then
				if exec(unpack(v.postcondition)) then
					exec(unpack(v.functor))
				end
			else
				exec(unpack(v.functor))
			end
		end
	end
	
    if self.Save_INI then
        self.Save_INI = false
        ini_options:save()
    end
	
	local dont_play_sound = false
	if self.Change_Done then
		self.Change_Done = false

		SendScriptCallback("experience_on_option_change", dup_table(opt_temp))

		self:SetMsg(game.translate_string("ui_experience_options_change_done"), 5)
		self:UpdateActorStats()
		dont_play_sound = true
		self:PlaySND("on_accept_1")
	end

	empty_table(opt_temp)
	empty_table(opt_backup)

	self:CloseWindow(dont_play_sound)
end

function UIExperienceOptions:OnButton_Default()
	if self.Cache.last_path and self.Cache.last_curr_tree then
		self:Reset_opt(self.Cache.last_curr_tree, self.Cache.last_path, {def = true})
		self:PlaySND("menu_click_3")
	end
end

function UIExperienceOptions:OnButton_Cancel()
	self:CloseWindow()
end