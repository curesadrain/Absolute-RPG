end

function delete_framework_func(ui)
	ui.owner:CloseCurrentWindow(true)
	ui.owner:Close()
	experience_error.RemoveExperienceFramework()
end
---------------------------------------------------------------------------------------

function sort_option_func(t,a,b)
	return game.translate_string(opt_str_menu .. t[a].id) < game.translate_string(opt_str_menu .. t[b].id)
end

function sort_preset_func(t,a,b)
	return game.translate_string(opt_str_prst .. a) < game.translate_string(opt_str_prst .. b)
end

function cc(path, opt)
    return path .. _opt_ .. opt
end

function exec(func,...)
	if not func then
		return false
	end
	return func(...)
end

function path_opt_explode(id, by_index)
	local path = by_index and opt_index[id] or id
	local t = path and str_explode(path, _opt_) or {}

	if by_index then
		for i=1, #t do
			t[i] = tonumber(t[i])
		end
	end

	return t
end

function get_opt_table(id)
	local t = path_opt_explode(id, true)
	if #t == 0 then
		return {}
	end
	
	if #t == 1 then
		return options[t[1]]
	elseif #t == 2 then
		return options[t[1]].gr[t[2]]
	elseif #t == 3 then
		return options[t[1]].gr[t[2]].gr[t[3]]
	elseif #t == 4 then
		return options[t[1]].gr[t[2]].gr[t[3]].gr[t[4]]
	end
end

local is_loaded = false
function LoadOptions()
	if is_loaded then
		return
	end
	is_loaded = true

    empty_table(options)
    empty_table(opt_val)
    empty_table(opt_index)
    init_base_options()
	init_other_options()
    local defaults = ini_file("experience_framework\\absolute_defaults.ltx")
    local function apply_defaults(groups, prefix)
        for _, v in ipairs(groups) do
            local path = prefix == "" and v.id or prefix .. "/" .. v.id
            if v.gr then
                apply_defaults(v.gr, path)
            elseif allowed_type[v.type] and defaults:line_exist("options", path) then
                if v.val == 1 then
                    v.def = defaults:r_bool("options", path)
                elseif v.val == 2 then
                    v.def = defaults:r_float("options", path)
                else
                    v.def = defaults:r_string("options", path)
                end
            end
        end
    end
    apply_defaults(options, "")

    local function deploy_options(id, gr, num)
        local path
        for i=1, #gr do
            if allowed_type[gr[i].type] then
                path = id .. _opt_ .. gr[i].id
                opt_val[path] = gr[i].val
                opt_index[path] = num .. _opt_ .. i
            end
        end
    end

    local id_1,id_2,id_3
    for i=1, #options do
        id_1 = options[i].id
        if options[i].sh then
            deploy_options(id_1, options[i].gr, i)
        else
            for ii=1, #options[i].gr do
                id_2 = options[i].gr[ii].id
                if options[i].gr[ii].sh then
                    deploy_options(id_1 .. _opt_ .. id_2, options[i].gr[ii].gr, i .. _opt_ .. ii)
                else
                    for iii=1, #options[i].gr[ii].gr do
                        id_3 = options[i].gr[ii].gr[iii].id
                        if options[i].gr[ii].gr[iii].sh then
                            deploy_options(id_1 .. _opt_ .. id_2 .. _opt_ .. id_3, options[i].gr[ii].gr[iii].gr, i .. _opt_ .. ii .. _opt_ .. iii)
                        end
                    end
                end
            end
        end
    end
    if not ini_options:r_value("rpg_gamma_unified", "level300_v1", 1, false) then
        if not ini_options:line_exist(opt_section, "Main/G_MAX_LEVEL") then
            ini_options:w_value(opt_section, "Main/G_MAX_LEVEL", 150)
        end
        ini_options:w_value("rpg_gamma_unified", "level300_v1", true)
        ini_options:save()
    end

end


