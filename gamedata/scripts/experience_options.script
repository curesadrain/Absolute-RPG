function azazel_new_progpress_precond()
	return gamemode_azazel.CAN_SEND_AZAZEL_CALLBACK and true or false
end

function haru_skills_precond()
	return haru_skills ~= nil
end

function xp_alert_sound_on_select(key)
	experience_sounds.Play("alert_gain_xp_" .. key, nil, opt_temp["UI/XP_ALERTS_VOLUME"] or Get("UI/XP_ALERTS_VOLUME"))
end

function levelup_alert_sound_on_select(key)
	experience_sounds.Play("alert_level_up_" .. key, nil, opt_temp["UI/LVLUP_ALERTS_VOLUME"] or Get("UI/LVLUP_ALERTS_VOLUME"))
end

function tasks_manager_precond()
	local tsk = experience_tasks.GetXPTasks()
	return tsk and tsk:IsStarted()
end

function new_levels_mod_precond()
	return zzzz_for_level_add ~= nil
end

function force_refresh_tasks(ui)
	experience_tasks.GetXPTasks():Refresh()
	ui:PlaySND("on_accept_1")
	ui:SetMsg(game.translate_string("ui_experience_options_tasks_reloaded"), 5)
end

function target_hud_precond()
	return experience_npcs.HUD ~= nil
end

function change_target_hud_position(ui)
	ui.owner:CloseCurrentWindow(true)
	ui.owner:Close()
	experience_npcs.edit_target_hud()
end

function reset_target_hud_position(ui)
	local hud = experience_npcs.HUD
    local pos_x = experience_utils.ReadConfig("nls_target_hud", "pos_x_def", 2)
    local pos_y = experience_utils.ReadConfig("nls_target_hud", "pos_y_def", 2)
	if (pos_x and pos_y) then
		experience_utils.WriteConfig("nls_target_hud", "pos_x", pos_x)
        experience_utils.WriteConfig("nls_target_hud", "pos_y", pos_y)
		if hud ~= nil then
			hud:UpdatePosition(pos_x, pos_y)
		end
		ui:PlaySND("on_accept_1")
		ui:SetMsg("Position Reset!", 5)
	end
end

function ironman_roguelite_precond()
