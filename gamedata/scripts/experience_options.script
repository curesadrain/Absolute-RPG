---------------------------------------------------------------------------------------
-- Experience Framework
-- Options Menu

-- Based on the options menu from 'ui_options.script'
-- Use the 'Get' and 'Set' functions from this script to get or save the settings value
-- Use the 'experience_on_option_change' callback like a 'on_option_change' to update your variables, after changing the settings
-- The settings are imported in the same way as in MCM, but the file should be named '*_exp.script' and the function in it is 'on_exp_load'
---------------------------------------------------------------------------------------


local options = {}
