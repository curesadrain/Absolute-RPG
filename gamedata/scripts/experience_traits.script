class "UIExperienceTraits" (CUIWindow)
function UIExperienceTraits:__init(owner, xml) super()
    self.owner = owner
    self.xml = xml
    self.clr = dup_table(owner.clr)
    self.clr.hide = GetARGB(110,255,255,255)
    self.slots = {
        [1] = { prestige = 0, id = nil, clr = nil },
        [2] = { prestige = 1, id = nil, clr = nil },
        [3] = { prestige = 0, id = nil, clr = nil },
        [4] = { prestige = 2, id = nil, clr = nil },
        [5] = { prestige = 4, id = nil, clr = nil },
        [6] = { prestige = 3, id = nil, clr = nil }
    }
    self.max_qual_lvl = 7   -- DONT TOUCH!!!
    self.exp_per_level = 20
    self.quality_exp_mult = {
        [1] = 0.2,    -- very_bad
        [2] = 0.4,    -- bad
        [3] = 0.8,    -- normal
        [4] = 1.2,    -- good
        [5] = 1.8,    -- epic
        [6] = 3,      -- legendary
        [7] = 5       -- mythic
    }
    self.quality_to_name = {
        [1] = "ui_experience_traits_wnd_trait_quality_very_bad",
        [2] = "ui_experience_traits_wnd_trait_quality_bad",
        [3] = "ui_experience_traits_wnd_trait_quality_normal",
        [4] = "ui_experience_traits_wnd_trait_quality_good",
        [5] = "ui_experience_traits_wnd_trait_quality_epic",
        [6] = "ui_experience_traits_wnd_trait_quality_legendary",
        [7] = "ui_experience_traits_wnd_trait_quality_mythic"
    }
    self.inc_quality_msg = {
        [2] = "ui_experience_traits_wnd_trait_inc_quality_bad_msg",
        [3] = "ui_experience_traits_wnd_trait_inc_quality_normal_msg",
        [4] = "ui_experience_traits_wnd_trait_inc_quality_good_msg",
        [5] = "ui_experience_traits_wnd_trait_inc_quality_epic_msg",
        [6] = "ui_experience_traits_wnd_trait_inc_quality_legendary_msg",
        [7] = "ui_experience_traits_wnd_trait_inc_quality_mythic_msg"
    }
    self.quality_colors = {
        [1] = GetARGB(255,210,20,20),
        [2] = GetARGB(255,205,205,205),
        [3] = GetARGB(255,100,220,140),
        [4] = GetARGB(255,35,110,175),
        [5] = GetARGB(255,180,65,240),
        [6] = GetARGB(255,240,195,40),
        [7] = GetARGB(255,240,100,40)
    }
    self.ppfx_quality_colors = {
        [1] = {210,20,20},
        [2] = {205,205,205},
        [3] = {100,220,140},
        [4] = {35,110,175},
        [5] = {180,65,240},
        [6] = {240,195,40},
        [7] = {240,100,40}
    }
    self.cont = {
        traits          = {},
        upgrade         = {}
    }
    self.trait_in_slots = {}
    self.slot_upgr      = {}
    self.controls       = { mode = 1 }
    self.selected       = { id = nil, slot = nil }
    self.upgr_mode      = { name = nil, sec = nil, curr_level = nil, quality = nil, chance = 0 }
    self.hold_id        = nil
    self.db             = { slot = nil, tg = 0 }
    self.cached_name    = { sec = nil, lvl = nil, qual = nil, str = nil }
    self.msg_box_mode   = "none"
