----------------------------------------------------
-- Experience Framework
-- Traits System Handler and UI
----------------------------------------------------



local tr_mngr = nil

function get_traits_manager()
    return tr_mngr
end

function get_traits_table(by_keys)
    local tbl = {}
    if tr_mngr ~= nil then
        for sec in spairs(tr_mngr.loaded_traits, function(t,a,b) return a < b end) do
            if by_keys then
                tbl[#tbl + 1] = sec
            else
                tbl[sec] = true
            end
        end
    end
    return tbl
end

local monsters_to_spawn_traits = {
    ["burer"]           = true,
    ["controller"]      = true,
    ["snork"]           = true,
    ["fracture"]        = true,
    ["karlik"]          = true,
    ["zombie"]          = true,
    ["pseudodog"]       = true,
    ["psy_dog"]         = true,
    ["gigant"]          = true,
    ["chimera"]         = true,
    ["bloodsucker"]     = true,
    ["psysucker"]       = true
}

local shuffle_cnt = 0
local shuffle_max = 2
local spawn_trait_list = {}
function try_spawn_trait(box, typ)
    local tr_cnt = #spawn_trait_list
    if tr_cnt == 0 then
        return
    end

    if math.random(1, 100) > experience_options.Get("Main/TRAITS_SPAWN_CHANCE_" .. typ) then
        return
    end

    local amount = math.random(0, experience_options.Get("Main/MAX_SPAWN_TRAITS"))
    if amount == 0 then
        return
    end

    SendScriptCallback("experience_on_before_spawn_traits", box, typ, amount)

    local sec
    for i=1, amount do
        sec = spawn_trait_list[ math.random(1, tr_cnt) ]
        if sec then
            if typ == "stash" or typ == "stalker" then
                alife_create_item(sec, box)

            elseif typ == "mutant" then
                if not box[sec] then
                    box[sec] = {count = 0}
                end
                box[sec].count = box[sec].count + 1
            end
        end
    end

    shuffle_cnt = shuffle_cnt + 1
    if shuffle_cnt > shuffle_max then
        shuffle_table(spawn_trait_list)
        shuffle_cnt = 0
    end
end

----------------------------------------------------
-- Callbacks
----------------------------------------------------
local function actor_on_first_update()
    tr_mngr = ExperienceTraitsManager()

    local cnt = 0
    for sec in pairs(tr_mngr.loaded_traits) do
        cnt = cnt + 1
        spawn_trait_list[cnt] = sec
    end
end

function monster_on_loot_init(victim, loot_table)
    local name = experience_utils.GetMutantName(victim)
    if monsters_to_spawn_traits[name] then
        try_spawn_trait(loot_table, "mutant")
    end
end

local function experience_on_destroy()
    UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
    UnregisterScriptCallback("monster_on_loot_init", monster_on_loot_init)
	if tr_mngr then
        tr_mngr:unregister_callbacks()

        local sim = alife()
        for i=1, 65534 do
            local se_obj = sim:object(i)
            if (se_obj and tr_mngr.loaded_traits[se_obj:section_name()]) then
                alife_release(se_obj)
            end
        end
    end
end

function on_game_start()
    if experience_utils.CanStartFramework() then
        RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
        RegisterScriptCallback("monster_on_loot_init", monster_on_loot_init)
        experience_error.SetRemover(experience_on_destroy)
    end
end


----------------------------------------------------
-- Traits Manager
----------------------------------------------------
class "ExperienceTraitsManager"
function ExperienceTraitsManager:__init()
    self.loaded_traits = {}
    self.db_traits = {}
    self.indexer = 0
    self.descr_cache = {txt = "", id = 0, level = 0}
    self.quality_chances = {
        [0] = {     -- Prestige
            0.75,
            0.50,
            0.15,
            0.05,
            0.02,
            0.004,
            0.002
        },
        [1] = {
            0.50,
            0.25,
            0.30,
            0.15,
            0.05,
            0.01,
            0.005
        },
        [2] = {
            0.25,
            0.10,
            0.45,
            0.40,
            0.10,
            0.05,
            0.02
        },
        [3] = {
            0.10,
            0.05,
            0.40,
            0.50,
            0.20,
            0.09,
            0.05
        },
        [4] = {
            0.05,
            0.01,
            0.25,
            0.60,
            0.40,
            0.15,
            0.10
        }
    }

    -- Load Savedata
    local traits_savedata = {}
    local m_data = alife_storage_manager.get_state()
    if (m_data and m_data.experience_framework_savedata and m_data.experience_framework_savedata.traits_savedata) then
        traits_savedata = m_data.experience_framework_savedata.traits_savedata[1] or {}
        self.indexer = m_data.experience_framework_savedata.traits_savedata[2] or 0
    end

    self:load_traits()
    self:register_callbacks()

    -- Absorb Traits From Inventory
	db.actor:iterate_inventory(function(temp, obj)
        local sec = obj:section()
		if self.loaded_traits[sec] then
			self:actor_on_take_trait(obj, sec)
		end
	end)

    -- Init Saved Traits
    for id, v in pairs(traits_savedata) do
        if self.loaded_traits[v.section] then
            self.db_traits[id] = trait_object(id, v.section, v.quality, self.loaded_traits[v.section], v.curr_level, v.state, v.slot)
        end
    end
end

function ExperienceTraitsManager:register_callbacks()
    RegisterScriptCallback("save_state", self)
    RegisterScriptCallback("actor_on_item_take", self)
end

function ExperienceTraitsManager:unregister_callbacks()
    UnregisterScriptCallback("save_state", self)
    UnregisterScriptCallback("actor_on_item_take", self)
end

function ExperienceTraitsManager:save_state(m_data)
	if not m_data.experience_framework_savedata then
		m_data.experience_framework_savedata = {}
	end
    if not m_data.experience_framework_savedata.traits_savedata then
		m_data.experience_framework_savedata.traits_savedata = {}
	end

    local traits_savedata = {}
    for id, tr in pairs(self.db_traits) do
        traits_savedata[id] = tr:savedata()
    end
	m_data.experience_framework_savedata.traits_savedata[1] = traits_savedata
    m_data.experience_framework_savedata.traits_savedata[2] = self.indexer
end

function ExperienceTraitsManager:actor_on_item_take(obj)
    local sec = obj and obj:section()
    if not (obj and self.loaded_traits[sec]) then
        return
    end
    CreateTimeEvent("experience_framework", "ExperienceTraitsManager_absorb_trait" .. obj:id(), 0.05, self.actor_on_take_trait, self, obj, sec)
end

function ExperienceTraitsManager:actor_on_take_trait(obj, sec)
    if not (obj and sec and self.loaded_traits[sec]) then
        return true
    end

    local id = self:create_trait(sec)
    if id then
        alife_release(obj)
    end
    return true
end

function ExperienceTraitsManager:load_traits()
    local ini_traits = ini_file("experience_framework\\traits\\_includes.ltx")
    ini_traits:section_for_each(function(section)
        local props = {
            ["max_level"]               = ini_traits:r_float_ex(section, "max_level"),
            ["functor_enable"]          = ini_traits:r_string_ex(section, "functor_enable"),
            ["functor_disable"]         = ini_traits:r_string_ex(section, "functor_disable"),
            ["functor_description"]     = ini_traits:r_string_ex(section, "functor_description")
        }
        self:add_trait(section, props)
    end)
    experience_dbg.Write(6, "Traits Loaded: %s", size_table(self.loaded_traits))
end

function ExperienceTraitsManager:add_trait(sec, props)
    if self.loaded_traits[sec] then
        experience_dbg.Write(1, "Error loading '%s' trait. | This trait already exist!", sec)
        return
    end

    if not (ini_sys:section_exist(sec) and experience_utils.IsTraitItem(sec)) then
        experience_dbg.Write(1, "Error loading '%s' trait. | Incorrect item!", sec)
        return
    end

    local t = {
        ["max_level"]               = true,
        ["functor_enable"]          = true,
        ["functor_disable"]         = true,
        ["functor_description"]     = true
    }

    for k in pairs(t) do
        local prop = props[k]
        if prop == nil then
            experience_dbg.Write(1, "Error loading '%s' trait. | The '%s' field was not found in its settings table!", sec, k)
			return
        end

        local prop_typ = type(prop)
        local err = nil

        if k == "max_level" then
            if prop_typ == "number" then
                prop = clamp(math.floor(prop), 1, 100)
            else
                err = strformat("Bad argument (number expected, got %s)", prop_typ)
            end

        elseif k == "functor_enable" or k == "functor_disable" or k == "functor_description" then
            local str = str_explode(prop, "%.")
            if (str[1] and str[2] and _G[ str[1] ] and _G[ str[1] ][ str[2] ]) then
                prop = _G[ str[1] ][ str[2] ]
            else
                err = strformat("Can't find function '%s' in %s.script", tostring(str[2]), tostring(str[1]))
            end
        end

        if err ~= nil then
            experience_dbg.Write(1, "Failed loading '%s' trait. | Incorrect value in the '%s' field! | ERROR: %s", sec, k, err)
            return
        end

        t[k] = prop
    end

    self.loaded_traits[sec] = t
    experience_dbg.WriteDebug(3, "'%s' Trait Successfully Loaded!", sec)
end

function ExperienceTraitsManager:get_option(sec, option)
    return self.loaded_traits[sec] and self.loaded_traits[sec][option]
end

function ExperienceTraitsManager:on_spawn(sec, qual, lvl)
    if not self.loaded_traits[sec] then
        return
    end

    self.indexer = self.indexer + 1
    self.db_traits[self.indexer] = trait_object(self.indexer, sec, qual, self.loaded_traits[sec], lvl)
    return self.indexer
end

function ExperienceTraitsManager:create_trait(sec)
    local qual_t = self.quality_chances[experience_utils.GetActorPrestige()] or self.quality_chances[4]
    local lvl = 0
    local qual

    while true do
        qual = math.random(#qual_t)
        if (math.random(1,1000)/1000) <= qual_t[qual] then
            break
        end
    end

    local flags = { level = lvl, quality = qual }
    SendScriptCallback("experience_on_before_init_trait", sec, flags)

    lvl = type(flags.level) == "number" and clamp(math.floor(flags.level), 0, self:get_option(sec, "max_level")) or lvl
    qual = type(flags.quality) == "number" and clamp(math.floor(flags.quality), 1, 7) or qual

    return self:on_spawn(sec, qual, lvl)
end

function ExperienceTraitsManager:trait_by_id(id)
    return self.db_traits[id]
end

function ExperienceTraitsManager:release_trait(obj, id)
    local tr = obj or self:trait_by_id(id)
    if not tr then
        return
    end
    tr:disable()
    self.db_traits[tr:id()] = nil
end

function ExperienceTraitsManager:trait_for_each(itr_func)
    for _,tr in spairs(self.db_traits, function(t,a,b) return a > b end) do
        if itr_func(tr) == true then
            return
        end
    end
end

----------------------------------------------------
-- Class "trait_object"
----------------------------------------------------
class "trait_object"
function trait_object:__init(id, section, quality, props, curr_level, state, slot)
    self.c_id           = id
    self.c_sec          = section
    self.c_name         = SYS_GetParam(0, self.c_sec, "inv_name") or ""
    self.c_qual         = quality or 1
    self.c_mlvl         = props.max_level
    self.c_func_on      = props.functor_enable
    self.c_func_off     = props.functor_disable
    self.c_func_desc    = props.functor_description
    self.c_lvl          = curr_level or 0
    self.c_st           = state or false
    self.c_st_slot      = slot or -1

    self:update()
end

function trait_object:enable(i)
    if not self.c_st then
        self.c_st = true
        self.c_st_slot = i
        self:update()
    end
end

function trait_object:disable()
    if self.c_st then
        self.c_st = false
        self.c_st_slot = -1
        self.c_func_off(self.c_id, self.c_sec)
    end
end

function trait_object:update()
    if self.c_st then
        self.c_func_on(self.c_id, self.c_sec, self.c_lvl, self.c_qual)
    end
end

function trait_object:set_level(num)
    if (type(num) == "number" and self.c_lvl ~= num) then
        self.c_lvl = clamp(math.floor(num), 0, self.c_mlvl)
        self:update()
    end
end

function trait_object:set_quality(num)
    if (type(num) == "number" and self.c_qual ~= num) then
        self.c_qual = clamp(math.floor(num), 1, 7)
        self:update()
    end
end

function trait_object:set_slot(num)
    self.c_st_slot = num
end

function trait_object:is_max()
    return self.c_lvl >= self.c_mlvl
end

function trait_object:is_enabled()
    return self.c_st
end

function trait_object:id()
    return self.c_id
end

function trait_object:section()
    return self.c_sec
end

function trait_object:quality()
    return self.c_qual
end

function trait_object:slot()
    return self.c_st_slot
end

function trait_object:name()
    return game.translate_string(self.c_name)
end

function trait_object:description()
    return self.c_func_desc(self.c_id, self.c_sec, self.c_lvl, self.c_qual) or ""
end

function trait_object:level()
    return self.c_lvl
end

function trait_object:max_level()
    return self.c_mlvl
end

function trait_object:savedata()
    return { section = self.c_sec, quality = self.c_qual, curr_level = self.c_lvl, state = self.c_st, slot = self.c_st_slot }
end
