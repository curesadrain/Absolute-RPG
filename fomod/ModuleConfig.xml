<?xml version='1.0' encoding='utf-8'?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Absolute RPG v1.7.5 TEST</moduleName>
  <requiredInstallFiles>
    <folder source="gamedata" destination="gamedata" priority="0" />
    <folder source="licenses" destination="licenses" priority="0" />
    <file source="README_RU.txt" destination="README_RU.txt" priority="0" />
    <file source="CREDITS.txt" destination="CREDITS.txt" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Выберите систему магазинов">
      <optionalFileGroups order="Explicit">
        <group name="Совместимость магазинного питания" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="GAMMA/No Mags">
              <description>Для обычной GAMMA или игры без отдельной системы магазинов. «Быстрая снарядка» работает только при наличии совместимого магазинного мода.</description>
              <typeDescriptor>
                <type name="Recommended" />
              </typeDescriptor>
            </plugin>
            <plugin name="CLIKRAD без анимаций">
              <description>Для GAMMA Mags Reloaded Forked без анимированной зарядки. «Быстрая снарядка» ускоряет работу с магазинами и добавляет места на надетом костюме. Не выбирайте этот вариант при включённых анимациях AML.</description>
              <files>
                <folder source="variants/clikrad/gamedata" destination="gamedata" priority="10" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="CLIKRAD с анимациями">
              <description>Для GAMMA Mags Reloaded Forked и Animated Magazine Loading. Включите интеграцию AML в настройках магазинов. «Быстрая снарядка» ускоряет зарядку и разрядку, включая анимации, и добавляет места на надетом костюме.</description>
              <files>
                <folder source="variants/clikrad_aml/gamedata" destination="gamedata" priority="10" />
              </files>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>